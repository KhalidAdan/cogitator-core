    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "isbot": "^5.2.2",
    "kysely": "^0.29.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
