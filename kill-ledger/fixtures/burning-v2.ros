        </profile>
        <profile name="Deadly Demise D3" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">This ability always takes the form Deadly Demise X. Each time a model with this ability is destroyed, after the units embarked within it (if any) have made their emergency disembark moves, roll one D6. On a 6, that model suffers a deadly demise; each unit within 6&quot; of that model suffers a number of mortal wounds denoted by X (if this is a random number, roll separately for each unit within 6&quot;).</characteristic>
          </characteristics>
        </profile>
        <profile name="Battle Focus" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Wave Serpent Shield" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">Each time a ranged attack targets this model, if the Strength characteristic of that attack is greater than the Toughness characteristic of this model, subtract 1 from the Wound roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
