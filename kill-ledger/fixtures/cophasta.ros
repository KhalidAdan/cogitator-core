        </profile>
        <profile name="Shattered Defences" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">In your Shooting phase, when this unit has shot, select one enemy Monster/Vehicle unit hit by those attacks. Friendly Adeptus Astartes units’ ranged attacks that target that enemy unit have +1 AP.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise D3" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">This ability always takes the form Deadly Demise X. Each time a model with this ability is destroyed, after the units embarked within it (if any) have made their emergency disembark moves, roll one D6. On a 6, that model suffers a deadly demise; each unit within 6&quot; of that model suffers a number of mortal wounds denoted by X (if this is a random number, roll separately for each unit within 6&quot;).</characteristic>
          </characteristics>
        </profile>
        <profile name="Thunderstrike" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">This unit’s ranged attacks that target a Monster/Vehicle unit have +1 to wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">Each time this unit makes an ingress move (20.04), if every model in this unit has this ability, it can be set up anywhere on the battlefield that is more than 8&quot; horizontally from all enemy units, even if that is within your opponent’s deployment zone.</characteristic>
          </characteristics>
        </profile>
      </profiles>
