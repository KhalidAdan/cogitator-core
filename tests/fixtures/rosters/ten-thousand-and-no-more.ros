        <profile name="Deep Strike" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">Each time this unit makes an ingress move (20.04), if every model in this unit has this ability, it can be set up anywhere on the battlefield that is more than 8&quot; horizontally from all enemy units, even if that is within your opponent’s deployment zone.</characteristic>
          </characteristics>
        </profile>
        <profile name="Martial Ka’tah" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Stand Vigil" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">Each time a model in this unit makes an attack, re-roll a Wound roll of 1. While this unit is within range of an objective marker you control, you can re-roll the Wound roll instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sentinel Storm" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">Once per battle, in your Shooting phase, after this unit has shot, it can shoot again.</characteristic>
          </characteristics>
        </profile>
      </profiles>
