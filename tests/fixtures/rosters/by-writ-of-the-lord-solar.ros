<roster id="40kapp-export" name="BY WRIT OF THE LORD SOLAR!" battleScribeVersion="2.03" gameSystemId="sys-352e-adc2-7639-d6a9" gameSystemName="Warhammer 40,000 10th Edition" xmlns="http://www.battlescribe.net/schema/rosterSchema">
  <forces>
    <force name="Army Roster" catalogueName="Astra Militarum">
      <selections>
    <selection name="Lord Solar Leontus" type="model" number="1">
      <profiles>
        <profile name="Lord Solar Leontus" typeName="Unit">
          <characteristics>
            <characteristic name="M">12&quot;</characteristic>
            <characteristic name="T">4</characteristic>
            <characteristic name="SV">3+</characteristic>
            <characteristic name="W">8</characteristic>
            <characteristic name="LD">6+</characteristic>
            <characteristic name="OC">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable Save" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">4+</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">Before the battle, in the Muster Armies step, for each leader and support unit in your army, you can select one friendly bodyguard unit that unit can lead. That unit will then lead that bodyguard unit for the battle and form an attached unit with it.
Unless otherwise stated, each bodyguard unit can only have one leader unit and one support unit attached to it.
See Attached Units (19)</characteristic>
          </characteristics>
        </profile>
        <profile name="Voice of Command" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">-</characteristic>
          </characteristics>
        </profile>
        <profile name="The Lord Solar" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">At the start of your Command phase, if this model is on the battlefield, you gain 1CP.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Collegiate Astrolex" typeName="Abilities">
          <characteristics>
            <characteristic name="Description">After both players have deployed their armies, select up to three **ASTRA MILITARUM** units from your army and redeploy them. When doing so, you can set those units up in Strategic Reserves if you wish, regardless of how many units are already in Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
