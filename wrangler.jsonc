/**
 * Cogitator Core on Cloudflare Workers.
 *
 * Static files (the client build, under /cogitator-core/assets) are served by
 * Cloudflare before the Worker runs. Every other request goes to one Durable
 * Object, which holds the app's SQLite database and renders the pages; see
 * workers/app.ts.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cogitator-core",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "CogitatorCore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CogitatorCore"] }],

  "vars": {
    // "off": no scheduled checks; only "Check for updates" on the Database page
    "COGITATOR_AUTO_UPDATE": "on",
    // where the site is served; sign-in cookies are made for it (.dev.vars sets http://localhost:5173 locally)
    "BETTER_AUTH_URL": "https://khld.dev"
  },
  // secrets (wrangler secret put …; locally, in .dev.vars):
  //   BETTER_AUTH_SECRET  signs sessions
  //   SETUP_CODE          what /setup asks for before creating the owner's account

  // khld.dev/cogitator-core and everything under it; the rest of khld.dev is left for other sites
  "routes": [
    { "pattern": "khld.dev/cogitator-core", "zone_name": "khld.dev" },
    { "pattern": "khld.dev/cogitator-core/*", "zone_name": "khld.dev" },
    // OAuth discovery for MCP clients sits at the domain's root with the app's paths after it; only these reach the Worker
    { "pattern": "khld.dev/.well-known/oauth-authorization-server/*", "zone_name": "khld.dev" },
    { "pattern": "khld.dev/.well-known/oauth-protected-resource/*", "zone_name": "khld.dev" },
    { "pattern": "khld.dev/.well-known/openid-configuration/*", "zone_name": "khld.dev" }
  ],
  // only on khld.dev, where the zone's rate-limit rule covers it: no workers.dev address, no per-version preview links
  "workers_dev": false,
  "preview_urls": false,

  "observability": { "enabled": true },
  "upload_source_maps": true
}
